# Copy to .env and replace every example value before `docker compose up -d`.
MYSQL_DATABASE=pacman_multiplayer
MYSQL_USER=pacman_app
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
PACMAN_JWT_SECRET=replace-with-at-least-32-random-characters
ACCOUNT_DOMAIN=accounts.example.com
ROOM_DOMAIN=rooms.example.com
# Include your website origin and the packaged desktop origin.
PACMAN_ALLOWED_ORIGINS=https://your-game-site.example,scp-pac://app
